# TwinSense Backend Environment Variables Example
PROJECT_NAME="TwinSense: IoT Digital Twin Backend"
API_V1_PREFIX="/api"

# MQTT Configuration
# For external Wokwi simulation testing, use a publicly reachable broker (e.g. broker.hivemq.com or test.mosquitto.org)
# For local Mosquitto broker: MQTT_BROKER="localhost", MQTT_PORT=1883
MQTT_BROKER="broker.hivemq.com"
MQTT_PORT=1883
MQTT_USER=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="twinsense_fastapi_backend"

# Database
DATABASE_URL="sqlite:///./twinsense.db"

# Operating Simulation Mode: 'wokwi_esp32' | 'software_fallback'
DEFAULT_SIMULATION_MODE="software_fallback"
FALLBACK_INTERVAL_SEC=2.0
